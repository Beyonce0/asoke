# Copy to .env.local and fill in. Never commit .env.local.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row level security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Paystack ────────────────────────────────────────────────────────────────
# Dashboard → Settings → API Keys & Webhooks
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_
PAYSTACK_SECRET_KEY=sk_test_

# ── Site ────────────────────────────────────────────────────────────────────
# Used for auth redirects and Paystack callback URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Replies to enquiries are sent from the admin through resend.com.
# resend.com → API Keys → Create API key (sending access is enough).
RESEND_API_KEY=
# Who replies come from. Must be on a domain verified in Resend, e.g.
#   EMAIL_FROM="ÀṢỌKÉ <hello@asoke.ng>"
# Leave empty to use Resend's test sender, which can only deliver to the
# email address that owns the Resend account.
EMAIL_FROM=
# Where the customer's answer lands when they press reply. Optional.
EMAIL_REPLY_TO=
# ── Enquiry automation (Make) ───────────────────────────────────────────────
# The intake scenario's webhook. Server only. Ask the owner for the value.
MAKE_ENQUIRY_WEBHOOK_URL=
